# Example secrets kit. Copy to your private overlay as secrets-kit.env and edit.
# These are KEY NAMES, never values. Values live in the cloud environment's
# Environment Variables field; this manifest just tells the loader what to load.

# Load ANTHROPIC_API_KEY from a differently-named source so a bare
# ANTHROPIC_API_KEY in the cloud env never hijacks the session's own billing.
MAP ANTHROPIC_API_KEY=ANTHROPIC_API_KEY_APP

REQUIRE GEMINI_API_KEY
REQUIRE LANGFUSE_PUBLIC_KEY
REQUIRE LANGFUSE_SECRET_KEY

OPTIONAL LANGFUSE_HOST=https://cloud.langfuse.com
OPTIONAL CLOUDFLARE_API_TOKEN
OPTIONAL CLOUDFLARE_ACCOUNT_ID
